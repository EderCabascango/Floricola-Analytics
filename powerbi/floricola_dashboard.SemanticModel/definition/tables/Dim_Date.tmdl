		sourceColumn: [AnioMes]

		annotation SummarizationSetBy = Automatic

	column AnioSemana = [Anio] & "-" & FORMAT([SemanaISO], "00")
		lineageTag: 50b91c7a-eeac-4eaf-9c86-b6e0417c44c1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				VAR FechaInicio = DATE(2023, 6, 1)
				VAR FechaFin = DATE(2026, 6, 30)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(FechaInicio, FechaFin),
				    "Anio", YEAR([Date]),
				    "NumeroMes", MONTH([Date]),
				    "NombreMes", FORMAT([Date], "MMMM"),
				    "NombreMesCorto", FORMAT([Date], "MMM"),
				    "Trimestre", "Q" & FORMAT([Date], "Q"),
				    "SemanaISO", WEEKNUM([Date], 2),
				    "DiaSemana", FORMAT([Date], "dddd"),
				    "AnioMes", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = 6dd5492a68dd4d74aa43b83160b4905f

